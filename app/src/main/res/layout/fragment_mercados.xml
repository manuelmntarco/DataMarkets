<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.mercados.MercadosFragment">

    <!-- Header azul -->
    <TextView
        android:id="@+id/textHeader"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/azul_primario"
        android:gravity="center"
        android:text="Mercados"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Filtros -->
    <HorizontalScrollView
        android:id="@+id/scrollFiltros"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textHeader">

        <LinearLayout
            android:id="@+id/contenedorFiltros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnTodas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/fondo_boton_inactivo"
                android:textColor="@color/black"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Todas"
                android:textSize="14sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/btnGanadoras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/fondo_boton_inactivo"
                android:textColor="@color/black"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:drawableStart="@drawable/ic_trending_up"
                android:drawablePadding="4dp"
                android:drawableTint="@color/azul_primario"
                android:text="Ganadoras"
                android:textSize="14sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/btnPerdedoras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/fondo_boton_inactivo"
                android:textColor="@color/black"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:drawableStart="@drawable/ic_trending_down"
                android:drawablePadding="4dp"
                android:drawableTint="@color/azul_primario"
                android:text="Perdedoras"
                android:textSize="14sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/btnTopCap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_boton_inactivo"
                android:textColor="@color/black"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:drawableStart="@drawable/ic_star"
                android:drawablePadding="4dp"
                android:drawableTint="@color/azul_primario"
                android:text="Top Cap"
                android:textSize="14sp"
                android:gravity="center" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ProgressBar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrollFiltros" />

    <!-- Lista de activos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerActivos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrollFiltros"
        tools:listitem="@layout/item_activo" />

</androidx.constraintlayout.widget.ConstraintLayout>